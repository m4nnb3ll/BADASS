# /root/dynamic_vxlan.sh: Configure Vxlan dynamically
#! /bin/bash
# Give the external interface an ip address to be able to communicate
ip addr add 192.168.1.1/30 dev eth1 # r1 (VTEP 1)

# r1
ip link add vxlan10 type vxlan id 10 group 239.1.1.1 dev eth1 dstport 4789
# turn up the vxlan
ip link set vxlan10 up

# Create a bridge (br0), and add both vxlan10 and host facing interface
ip link add name br0 type bridge
ip link set dev br0 up
ip link set vxlan10 master br0
ip link set eth0 master br0
