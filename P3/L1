# /etc/frr/frr.conf: Configure Route Reflector

# Configure interfaces

# to RR
interface eth1
  ip address 10.10.10.11/31

# loopback
interface lo
  ip address 1.1.1.11/32

# Configure the underlay
router ospf
  network 0.0.0.0/0 area 0

# Configure BGP
router bgp 1337
  neighbor 1.1.1.10 remote-as 1337
  neighbor 1.1.1.10 update-source lo

  address-family l2vpn evpn
    neighbor 1.1.1.10 activate
    advertise-all-vni
